# Copy to ignored .env.production; replace placeholders with DIFFERENT random values.
# Database passwords must be hex (URL-safe); generate with secrets.token_hex(32).
PUBLIC_DOMAIN=career.example.com
PUBLIC_ORIGIN=https://career.example.com
POSTGRES_PASSWORD=replace_with_random_hex
ANALYTICS_ROLE_PASSWORD=replace_with_different_random_hex
APP_ROLE_PASSWORD=replace_with_another_random_hex
DEMO_USERNAME=viewer
DEMO_PASSWORD=replace_with_a_long_random_password
DEMO_COOKIE_SECRET=replace_with_a_different_random_secret_at_least_32_chars
ADMIN_KEY=replace_with_another_random_secret_at_least_32_chars
CLIENT_REQUESTS_PER_MINUTE=60
CLIENT_LLM_ROUTES_PER_DAY=10
LLM_GLOBAL_DAILY_CALL_LIMIT=0
