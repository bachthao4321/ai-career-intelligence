# LOCAL DEVELOPMENT ONLY. These credentials are not suitable for a public deployment.
APP_NAME="AI Career Intelligence"
APP_ENV=local
POSTGRES_DB=career
POSTGRES_USER=career
POSTGRES_PASSWORD=career_local_only
# Host execution; Compose overrides hostnames with postgres / qdrant.
DATABASE_URL=postgresql+psycopg://career:career_local_only@localhost:5432/career
QDRANT_URL=http://localhost:6333
DEPENDENCY_TIMEOUT_SECONDS=2
DB_STATEMENT_TIMEOUT_MS=5000

# Optional M1 extraction. Disabled by default; never commit real credentials.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_DAILY_CALL_LIMIT=0

# Local M2 embeddings. Download explicitly; API requests never download model files.
EMBEDDING_MODEL_DIR=models/multilingual-minilm
EMBEDDING_THREADS=2
QDRANT_COLLECTION_PREFIX=career_jobs
VECTOR_TIMEOUT_SECONDS=30
SEARCH_CORPUS_LIMIT=5000
RRF_K=60
RRF_BM25_WEIGHT=0.5
RRF_DENSE_WEIGHT=1
