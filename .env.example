# LOCAL DEVELOPMENT ONLY. These credentials are not suitable for a public deployment.
APP_NAME="AI Career Intelligence"
APP_ENV=local
POSTGRES_DB=career
POSTGRES_USER=career
POSTGRES_PASSWORD=career_local_only
# Host execution; Compose overrides hostnames with postgres / qdrant.
DATABASE_URL=postgresql+psycopg://career:career_local_only@localhost:5432/career
QDRANT_URL=http://localhost:6333
DEPENDENCY_TIMEOUT_SECONDS=2
DB_STATEMENT_TIMEOUT_MS=5000

# Optional M1 extraction. Disabled by default; never commit real credentials.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_DAILY_CALL_LIMIT=0

# Local M2 embeddings. Download explicitly; API requests never download model files.
EMBEDDING_MODEL_DIR=models/multilingual-minilm
EMBEDDING_THREADS=2
QDRANT_COLLECTION_PREFIX=career_jobs
VECTOR_TIMEOUT_SECONDS=30
SEARCH_CORPUS_LIMIT=5000
RRF_K=60
RRF_BM25_WEIGHT=0.5
RRF_DENSE_WEIGHT=1

# M3: separate metadata-view-only login. Local development credentials only.
ANALYTICS_ROLE_PASSWORD=career_analytics_local_only_2026
ANALYTICS_DATABASE_URL=postgresql+psycopg://career_analytics_local:career_analytics_local_only_2026@localhost:5432/career
ANALYTICS_SCHEMA=public
ANALYTICS_TIMEOUT_MS=1500
# Optional OpenAI-compatible chat endpoint (for example local Qwen via Ollama).
# Disabled and zero daily calls by default. The counter is shared with M1 paid attempts.
AGENT_MODEL_ENABLED=false
AGENT_MODEL_BASE_URL=http://localhost:11434/v1
AGENT_MODEL_NAME=qwen3:8b
# AGENT_MODEL_API_KEY=
AGENT_DAILY_CALL_LIMIT=0

# M4: CV text profiles only; original PDF is never persisted.
CV_TTL_SECONDS=3600
CV_CAPACITY=1000
CV_CLEANUP_INTERVAL_SECONDS=60

# M5: shared public-job runtime. Defaults make no model requests.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
# Pin the actual model digest/provider version before a reproducible live evaluation.
LLM_MODEL_REVISION=unverified
# LLM_API_KEY=
LLM_DAILY_CALL_LIMIT=0
# Shared UTC-day ceiling across M1, M3 and M5, including failed attempts/retries.
LLM_GLOBAL_DAILY_CALL_LIMIT=100
LLM_TIMEOUT_SECONDS=15
LLM_MAX_ATTEMPTS=2
LLM_MIN_INTERVAL_SECONDS=0.5
LLM_CONCURRENCY=2
LLM_CACHE_TTL_SECONDS=3600
LLM_CACHE_CAPACITY=1000
RERANK_ENABLED=false
RERANK_CANDIDATES=10
RERANK_TIMEOUT_SECONDS=5

# M6: development remains loopback-only. Production uses compose.production.yaml.
DEMO_AUTH_ENABLED=false
CLIENT_LIMITS_ENABLED=false
DEMO_USERNAME=viewer
# DEMO_PASSWORD=           # >=16 characters when enabled
# DEMO_COOKIE_SECRET=      # independent >=32-character random secret
# ADMIN_KEY=               # independent >=32-character random key for /admin writes
# PUBLIC_ORIGIN=https://your-domain.example
# TRUSTED_PROXY_IP=        # exact socket peer only; Uvicorn must use --no-proxy-headers
DEMO_SESSION_SECONDS=7200
CLIENT_REQUESTS_PER_MINUTE=60
CLIENT_LLM_ROUTES_PER_DAY=10
