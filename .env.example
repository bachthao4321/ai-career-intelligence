# LOCAL DEVELOPMENT ONLY. These credentials are not suitable for a public deployment.
APP_NAME="AI Career Intelligence"
APP_ENV=local
POSTGRES_DB=career
POSTGRES_USER=career
POSTGRES_PASSWORD=career_local_only
# Host execution; Compose overrides hostnames with postgres / qdrant.
DATABASE_URL=postgresql+psycopg://career:career_local_only@localhost:5432/career
QDRANT_URL=http://localhost:6333
DEPENDENCY_TIMEOUT_SECONDS=2
DB_STATEMENT_TIMEOUT_MS=5000
